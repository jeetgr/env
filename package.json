{
  "name": "@jeetgr/env",
  "version": "0.0.1",
  "description": "Typed env helper for Node and Vite using Standard Schema",
  "keywords": [
    "env",
    "schema",
    "standard-schema",
    "typescript",
    "validation",
    "vite"
  ],
  "homepage": "https://github.com/jeetgr/env#readme",
  "bugs": {
    "url": "https://github.com/jeetgr/env/issues"
  },
  "license": "MIT",
  "author": "jeetgr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeetgr/env.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run fmt:check && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "publint": "publint",
    "attw": "attw --pack .",
    "pack:check": "pnpm build && pnpm publint && pnpm attw",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0"
}
